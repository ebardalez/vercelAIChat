# Copia este archivo a .env.local y ajusta los valores.
# La URL base debe terminar en /v1 (endpoint compatible con OpenAI de Ollama).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# System prompt opcional (si no se define, se usa uno por defecto)
# SYSTEM_PROMPT=Eres un asistente útil. Responde en español, de forma clara y concisa.
